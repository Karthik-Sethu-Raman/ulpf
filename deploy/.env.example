# deploy/.env.example — copy to deploy/.env and adjust as needed.
# docker compose reads deploy/.env automatically; the real file is gitignored,
# so never commit it.

# Kafka bootstrap address for the streaming services (inside the compose network).
KAFKA_BOOTSTRAP=redpanda:9092

# Ollama endpoint used by the onboarding services for SLM calls.
ULPF_OLLAMA_URL=http://ollama-4b:11434

# Per-service database DSNs (pipeline, gateway, admin) are compose-internal
# constants defined in docker-compose.yml — M2 adds no user-facing DB knobs.
