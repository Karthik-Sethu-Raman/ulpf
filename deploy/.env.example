# deploy/.env.example — copy to deploy/.env and adjust as needed.
# docker compose reads deploy/.env automatically; the real file is gitignored,
# so never commit it.

# Kafka bootstrap address for the streaming services (inside the compose network).
KAFKA_BOOTSTRAP=redpanda:9092

# Ollama endpoint used by the onboarding services for SLM calls.
# Default (8GB boxes): the 4b sidecar, enabled by `--profile slm-4b`.
ULPF_OLLAMA_URL=http://ollama-4b:11434

# SLM tier tag pulled by the sidecar at startup. Default qwen3:4b; 16GB boxes
# may upgrade via `--profile slm-8b` + ULPF_OLLAMA_URL=http://ollama-8b:11434
# + ULPF_OLLAMA_MODEL=qwen3:8b. The ollama sidecars publish NO host port —
# they are reachable only inside the compose network (onboarding-internal).
ULPF_OLLAMA_MODEL=qwen3:4b

# Drift engine knobs (M3) — read by services/drift's Config.from_env;
# docker compose passes them through to the drift service. The acceptance
# smoke (scripts/smoke.py) exports WINDOW_COUNT=30 plus a huge WINDOW_TIME_S
# (count-close only) in its own environment before compose up, so demo
# windows close on deterministic 30-row boundaries (a short time horizon
# slices the accumulated days-spread history into one-row windows — see the
# smoke header).
ULPF_DRIFT_WINDOW_COUNT=1000
ULPF_DRIFT_WINDOW_TIME_S=600
ULPF_DRIFT_BASELINE_WINDOWS=10
ULPF_DRIFT_POLL_S=5

# Onboarding sample-capture cap per fingerprint (pipeline). The accumulating
# acceptance runs saturate the default 200 — the smoke exports a larger value
# so a drift-deactivated fingerprint can still show sample growth (K).
ULPF_SAMPLE_CAPTURE_CAP=200

# Per-service database DSNs (pipeline, gateway, admin) are compose-internal
# constants defined in docker-compose.yml — M2 adds no user-facing DB knobs.
