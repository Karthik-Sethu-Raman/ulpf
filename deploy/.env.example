# deploy/.env.example — copy to deploy/.env and adjust as needed.
# docker compose reads deploy/.env automatically; the real file is gitignored,
# so never commit it. The values below are the M1 development defaults that
# docker-compose.yml also hardcodes for the in-network services.

# Pipeline service — least-privilege role: INSERT+SELECT on raw_events,
# raw_batches, normalized_events, onboarding_samples; SELECT on rules.
PIPELINE_DATABASE_URL=postgresql://pipeline_role:pipeline_dev@postgres:5432/ulpf

# Gateway service — read-only role: SELECT on all ulpf tables.
GATEWAY_DATABASE_URL=postgresql://gateway_role:gateway_dev@postgres:5432/ulpf

# Kafka bootstrap address for the streaming services (inside the compose network).
KAFKA_BOOTSTRAP=redpanda:9092
